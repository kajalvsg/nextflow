# Clerk — get keys from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string (Neon, Supabase, etc.)
# Use the *pooled* Neon URL (hostname contains "-pooler") for the app runtime.
# If the dashboard hangs or shows a DB error, confirm the project is active in Neon
# and that your network allows outbound HTTPS/WSS to Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require

# Trigger.dev — https://trigger.dev/docs
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=proj_alwnrsxdtapnxqezdbel

# Gemini (server-side only — never expose to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Demo mode — when true, Gemini is never called (pipeline demo only)
DEMO_MODE=false

# Temporary Gemini integration debug logs (Trigger worker / server only)
GEMINI_DEBUG=true
