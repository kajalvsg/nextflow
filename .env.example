# Clerk — get keys from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Must match the URL you use in the browser (including port).
# If you open the app via a LAN IP, use that IP here — not localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: extra hosts for Next.js dev (comma-separated, no protocol).
# Example when opening http://10.65.161.206:3000 from another device:
# ALLOWED_DEV_ORIGINS=10.65.161.206
ALLOWED_DEV_ORIGINS=

# Prefer Neon when reachable; falls back to local PGlite when Neon is down.
USE_LOCAL_DB=true

# PostgreSQL connection string (Neon, Supabase, etc.)
# Use the *pooled* Neon URL (hostname contains "-pooler") for the app runtime.
# Do NOT include channel_binding=require — it breaks Node pg on Windows.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require


# Trigger.dev — https://trigger.dev/docs
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Gemini (server-side only — never expose to the browser)
# Stable fast options: gemini-1.5-flash (default), gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# Transloadit — image uploads for Request Inputs image_field
# Auth key is public; secret stays server-side only.
# Leave blank to use local file upload fallback.
NEXT_PUBLIC_TRANSLOADIT_AUTH_KEY=
TRANSLOADIT_AUTH_SECRET=
# Optional: use a Transloadit template instead of the default :original upload step
TRANSLOADIT_TEMPLATE_ID=
